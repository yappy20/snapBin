# Copy this file to .env for local/VPS use (docker compose reads it
# automatically). On Railway, set these as service Variables instead —
# there is no .env file in that deployment.
#
# Nothing here is required to run SnapBin — without any AI key the app
# still works for manual inventory management; the AI-recognition "Scan"
# tab will just tell you no provider is configured.

# ---- AI vision provider (pick one) ----
# Recommended: an Anthropic API key with a vision-capable model (Claude Sonnet/Haiku).
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Alternative: OpenAI GPT-4o / GPT-4o-mini vision.
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ---- Datasheet / pricing enrichment (optional) ----
# Free key at https://www.mouser.com/api-hub/
MOUSER_API_KEY=

# ---- Security ----
# Shared secret hardware capture stations (RPi / ESP32-CAM) must send as
# `X-Capture-Key` when POSTing images to /api/capture. Set this before
# exposing SnapBin beyond localhost — which, once deployed, is always.
CAPTURE_API_KEY=change-me

# ---- Storage ----
# Where the SQLite database and uploaded photos live. Locally this defaults
# to ./data next to the code. On Railway, set this to your mounted volume's
# path (e.g. /app/data) so data survives redeploys.
DATA_DIR=./data

# ---- Port ----
# Railway (and most PaaS) inject this automatically — only set it yourself
# for local/VPS use if you want something other than 8000.
PORT=8000
